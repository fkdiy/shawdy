{
    skip_install_trust

    frankenphp
}

(app_routes) {
    encode zstd br gzip

    # Health check
    @health {
        path /healthz
    }

    handle @health {
        respond "OK" 200
    }

    # Symfony backend
    @backend {
        path \
            /api \
            /api/* \
            /_wdt \
            /_wdt/* \
            /_profiler \
            /_profiler/*
    }

    handle @backend {
        root * /app/public

        php_server {
            worker /app/public/index.php
        }
    }

    # Symfony static assets
    @static {
        path \
            /assets \
            /assets/*
    }

    handle @static {
        root * /app/public

        file_server
    }

    # Public landing page
    @home {
        path /
    }

    handle @home {
        reverse_proxy node:3000
    }

    # Nuxt application routes
    @app {
        path \
            /_nuxt \
            /_nuxt/* \
            /app \
            /app/*
    }

    handle @app {
        reverse_proxy node:3000
    }

    # A single root-level path segment represents a Short Code.
    @redirect {
        path_regexp shortcode ^/[^/]+$
    }

    handle @redirect {
        reverse_proxy redirector:8081
    }

    # Reject all unknown nested paths.
    handle {
        respond "Not Found" 404
    }
}

# Public endpoint
# Dev:  SERVER_NAME=http://localhost
# Prod: SERVER_NAME=https://shawdy.de

{$SERVER_NAME:http:localhost} {
    import app_routes
}

# Endpoint for communication inside the Docker network
# HTTP only

:8080 {
    import app_routes
}