{
    skip_install_trust

    frankenphp
}

(app_routes) {
    encode zstd br gzip

    # Health check
    @health {
        path /healthz
    }

    handle @health {
        respond "OK" 200
    }

    # Symfony backend
    @backend {
        path \
            /api \
            /api/* \
            /_wdt \
            /_wdt/* \
            /_profiler \
            /_profiler/*
    }

    handle @backend {
        root * /app/public

        php_server {
            worker /app/public/index.php
        }
    }

    # Symfony static assets
    @static {
        path \
            /assets \
            /assets/*
    }

    handle @static {
        root * /app/public

        file_server
    }

    # Nuxt application routes
    @frontend {
        path \
            / \
            /_nuxt \
            /_nuxt/* \
            /__nuxt_content/ \
            /__nuxt_content/* \
            /app \
            /app/* \
            /app-assets \
            /app-assets/* \
            /de \
            /de/* \
            /en \
            /en/* \
            /legal \
            /privacy \
            /report-abuse \
            /favicon.ico \
            /favicon.svg \
            /robots.txt
    }

    handle @frontend {
        reverse_proxy node:3000
    }

    # A single root-level path segment represents a Short Code.
    @redirect {
        path_regexp shortcode ^/[^/]+$
    }

    handle @redirect {
        reverse_proxy redirector:8081 {
            @redirectError status 404 500 502 503

            handle_response @redirectError {
                error {rp.status_code}
            }
        }
    }

    @errorAssets {
        path /errors/*
    }

    handle @errorAssets {
        root * /srv
        file_server
    }

    # Reject all unknown nested paths.
    handle {
        error 404
    }
}

(error_pages) {
    handle_errors {
        root * /srv/errors

        @customError file /{err.status_code}.html

        handle @customError {
            rewrite * /{err.status_code}.html
            file_server
        }

        handle {
            rewrite * /500.html
            file_server
        }
    }
}

# Public endpoint
# Dev:  SERVER_NAME=http://localhost
# Prod: SERVER_NAME=https://shawdy.de

{$SERVER_NAME:http://localhost} {
    rate_limit {
        zone short_url_creation {
            match {
                method POST
                path /api/short_urls
            }

            key         {remote_host}
            events      {$RATE_LIMIT_SHORT_URL_EVENTS:60}
            window      {$RATE_LIMIT_SHORT_URL_WINDOW:1m}
            ipv6_prefix 64
        }

        zone abuse_report_submission {
            match {
                method POST
                path /api/abuse_reports
            }

            key         {remote_host}
            events      {$RATE_LIMIT_ABUSE_REPORT_EVENTS:20}
            window      {$RATE_LIMIT_ABUSE_REPORT_WINDOW:1m}
            ipv6_prefix 64
        }
    }

    import app_routes
    import error_pages
}

# Endpoint for communication inside the Docker network
# HTTP only

:8080 {
    import app_routes
}
