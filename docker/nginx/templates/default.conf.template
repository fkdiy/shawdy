server {
    listen 80;
    server_name ${NGINX_HOST};

    root /usr/share/nginx/html;
    index index.html;

    # Serve the Vue.js application and fall back to index.html
    # for client-side routes handled by Vue Router.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Forward API requests to Symfony.
    location /api/ {
        try_files $uri /index.php$is_args$args;
    }

    # Serve Symfony assets such as API Platform's Swagger UI assets.
    location /assets/ {
        alias /var/www/html/public/assets/;
    }

    # Execute Symfony's PHP front controller through PHP-FPM.
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass ${PHP_UPSTREAM};
        fastcgi_param SCRIPT_FILENAME /var/www/html/public$fastcgi_script_name;
    }
}
