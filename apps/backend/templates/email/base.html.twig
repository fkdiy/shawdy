<!DOCTYPE html>
<html lang="{% block language %}de{% endblock %}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Shawdy{% endblock %}</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f9fbf9;
    color: #3d5240;
    font-family: sans-serif, arial;
">
    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background-color: #f9fbf9; padding: 0px 0px 32px 0px;"
    >
        <tr>
            <td align="center" style="padding: 32px 0px 0px 0px;">
                <img
                    src="{{ baseUrl }}/app-assets/logo_mail.png"
                    alt="Shawdy"
                    height="24"
                >
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 32px 16px;">
                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width: 640px;
                        background-color: #ffffff;
                        border-radius: 8px;
                        border: 1px solid #c4d4c7;
                    "
                >
                    <tr>
                        <td style="padding: 32px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 16px 0px 0px 0px;">
                <img
                    src="{{ baseUrl }}/app-assets/emblem_mail.png"
                    alt="Shawdy"
                    height="24"
                >
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 8px 0px 0px 0px;">
                <p style="color: #7fcd00; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace; font-size: 0.75rem; letter-spacing: 0.12em; margin: 0 0 8px;">
                    SHAWDY URL SHORTENER
                </p>
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 8px 0px 0px 0px;">
                <p style="margin: 0; color: #87a68c; font-size: 0.75rem;">
                    Fabian König&nbsp;&middot;&nbsp;c/o Impressumservice Dein-Impressum&nbsp;&middot;&nbsp;Stettiner Str. 41&nbsp;&middot;&nbsp;35410 Hungen
                </p>
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 16px 0px 0px 0px;">
                <p style="margin: 0; color: #87a68c; font-size: 0.75rem;">
                    <a
                        href="mailto:contact@shawdy.de"
                        style="color: #87a68c; text-decoration:none;"
                    >{% block contact_label %}Kontakt{% endblock %}</a>
                    &nbsp;&middot;&nbsp;
                    <a
                        href="{{ baseUrl }}/legal"
                        style="color: #87a68c; text-decoration:none;"
                    >{% block legal_label %}Impressum{% endblock %}</a>
                    &nbsp;&middot;&nbsp;
                    <a
                        href="{{ baseUrl }}/privacy"
                        style="color: #87a68c; text-decoration:none;"
                    >{% block privacy_label %}Datenschutz{% endblock %}</a>
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
