{% extends 'email/base.html.twig' %}

{% block language %}en{% endblock %}

{% block contact_label %}Contact{% endblock %}
{% block legal_label %}Legal notice{% endblock %}
{% block privacy_label %}Privacy policy{% endblock %}

{% block title %}
    New Shawdy abuse report
{% endblock %}

{% block content %}
    <h1 style="
        color: #111712;
        margin: 0 0 24px;
        font-size: 24px;
        line-height: 1.3;
    ">
        New abuse report
    </h1>

    <p style="color: #3d5240; margin: 0 0 16px; line-height: 1.6;">
        A new abuse report was submitted through Shawdy.
    </p>

    <p style="margin: 0; line-height: 1.6;">
        <strong style="color: #111712;">Reported Short URL:</strong>
        <a href="{{ shortUrl }}" style="color: #7fcd00; text-decoration:none;">
            {{ shortUrl }}
        </a>
    </p>

    <p style="margin: 0; line-height: 1.6;">
        <strong style="color: #111712;">Reported by:</strong>
        <a href="mailto:{{ report.email }}" style="color: #7fcd00; text-decoration:none;">
            {{ report.email }}
        </a>
    </p>

    <h2 style="
        color: #111712;
        margin: 16px 0 12px;
        font-size: 18px;
        line-height: 1.4;
    ">
        Message
    </h2>

    <div style="
        padding: 16px;
        background-color: #f9fbf9;
        color: color: #3d5240;
        border: 1px solid #c4d4c7;
        border-radius: 6px;
        line-height: 1.6;
        white-space: pre-wrap;
    ">{{ report.message }}</div>
{% endblock %}
