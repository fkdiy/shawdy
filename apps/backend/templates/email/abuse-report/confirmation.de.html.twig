{% extends 'email/base.html.twig' %}

{% block language %}de{% endblock %}

{% block title %}
    Deine Missbrauchsmeldung ist eingegangen
{% endblock %}

{% block content %}
    <h1 style="
        color: #111712;
        margin: 0 0 24px;
        font-size: 24px;
        line-height: 1.3;
    ">
        Vielen Dank für deine Meldung
    </h1>

    <p style="color: #3d5240; margin: 0 0 16px; line-height: 1.6;">
        Ich habe deine Meldung erhalten und werde sie zeitnah prüfen.
    </p>

    <p style="margin: 0; line-height: 1.6;">
        <strong style="color: #111712;">Gemeldete Short-URL:</strong>
        <a href="{{ shortUrl }}" style="color: #7fcd00; text-decoration:none;">
            {{ shortUrl }}
        </a>
    </p>
{% endblock %}
