{
  "config": {
    // Long lines are intentionally allowed because Markdown paragraphs
    // do not need to be hard-wrapped.
    "MD013": false
  },
  "overrides": [
    {
      "files": [
        ".github/ISSUE_TEMPLATE/**",
        ".github/pull_request_template.md"
      ],
      "config": {
        // GitHub templates intentionally start with section headings
        // because their title is provided by GitHub separately.
        "MD041": false
      }
    }
  ]
}