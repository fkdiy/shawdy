# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_size = 4

[{compose.yaml,compose.*.yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[frontend/**/*.{js,jsx,ts,tsx,mjs,mts,cjs,cts,vue,css,scss,json,jsonc,html,yaml,yml}]
indent_size = 2
